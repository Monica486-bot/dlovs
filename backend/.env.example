PORT=4000
DATABASE_URL=postgres://dlovs_user:your_password@localhost:5432/dlovs_db
JWT_SECRET=change_this_to_a_long_random_string
QR_SIGNING_SECRET=change_this_to_a_different_long_random_string
NODE_ENV=development

# Web app address(es) allowed to call the API, comma-separated. Leave empty in development.
CORS_ORIGINS=

# Document encryption (64 hex characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Losing it makes stored documents unreadable.
DOCUMENT_ENCRYPTION_KEY=

# Document storage: set to use Cloudinary; leave empty to store encrypted files in ./uploads
CLOUDINARY_URL=

# SMS via Africa's Talking. Leave AT_API_KEY empty to print codes to the server log instead.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
