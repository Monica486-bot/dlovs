PORT=4000
DATABASE_URL=postgres://dlovs_user:your_password@localhost:5432/dlovs_db
JWT_SECRET=change_this_to_a_long_random_string
QR_SIGNING_SECRET=change_this_to_a_different_long_random_string
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server won't start without them; in production they must be 32+ random characters.

# Password for every demo account created by `npm run seed` (local demos only)
SEED_PASSWORD=
NODE_ENV=development

# Web app address(es) allowed to call the API, comma-separated. Leave empty in development.
CORS_ORIGINS=

# The web app's public address. Printed QR codes link to <PUBLIC_WEB_URL>/verify/<parcel>,
# so set this to the Netlify address before printing markers.
PUBLIC_WEB_URL=http://localhost:5173

# Document encryption (64 hex characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Losing it makes stored documents unreadable.
DOCUMENT_ENCRYPTION_KEY=

# Document storage: set to use Cloudinary; leave empty to store encrypted files in ./uploads
CLOUDINARY_URL=

# SMS via Twilio. Leave TWILIO_ACCOUNT_SID empty to print codes to the server log instead.
# Sign up at https://twilio.com, get a phone number, and fill in the three values below.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Expo push notifications to the mobile app need no key. Set to true to switch them off.
PUSH_DISABLED=

# Tests (npm test) use this database, recreated on every run. Defaults to DATABASE_URL
# with the database renamed to dlovs_test. The name must end in _test.
TEST_DATABASE_URL=
